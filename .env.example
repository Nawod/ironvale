# npm start reads environment variables supplied by your host/shell.
# This file is a configuration example, not an automatically loaded secret file.
PORT=8180
HOST=0.0.0.0
DATA_DIR=./server-data
MAX_ROOMS=32
# Set this to the browser-visible HTTPS origin when publicly deployed:
# PUBLIC_ORIGIN=https://your-domain.example
# Optional built-in HTTPS. Both files must be supplied; browsers must trust the certificate.
# HTTPS_KEY_FILE=C:/certificates/game-key.pem
# HTTPS_CERT_FILE=C:/certificates/game-chain.pem
# Voice uses public STUN by default. Configure your own TURN relay when needed.
# This JSON is sent to browsers; use client relay credentials.
# VOICE_ICE_SERVERS=[{"urls":"turn:relay.example.com:3478","username":"client-user","credential":"client-credential"}]
